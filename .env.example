# Database connection (SQLite for local zero-config, or PostgreSQL for Neon/Supabase)
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Server-side only. Get a key at https://console.anthropic.com (or leave empty to use smart fallback)
ANTHROPIC_API_KEY=""

# Optional: override the Claude model
AI_MODEL="claude-sonnet-4-6"
